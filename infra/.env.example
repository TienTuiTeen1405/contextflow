# Copy to infra/.env. Development only; bind ports to localhost.
POSTGRES_DB=contextflow
POSTGRES_USER=contextflow
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_PORT=15432
CF_INTERNAL_SERVICE_TOKEN=replace-with-a-random-local-token
CF_WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
