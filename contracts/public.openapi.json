  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RequestState": {
        "type": "string",
        "enum": ["ACCEPTED", "IN_PROGRESS", "COMPLETED", "FAILED", "CANCELLED"]
      },
      "TerminalState": {
        "type": "string",
        "enum": ["COMPLETED", "FAILED", "CANCELLED"]
      },
      "PrivacyTier": {
        "type": "string",
        "enum": ["FREE", "PAID", "UNKNOWN"]
      },
      "UsageStatus": {
        "type": "string",
        "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE"]
      },
      "LinkStatus": {
        "type": "string",
        "enum": ["AVAILABLE", "UNAVAILABLE"]
      },
      "QuoteSourceKind": {
        "type": "string",
        "enum": [
          "MAIN_TURN",
          "SUB_BRANCH_TURN",
          "KB_ITEM",
          "SOT_RECORD",
          "CHAPTER_SUMMARY"
        ]
      },
      "CancelReason": {
        "type": "string",
        "enum": [
          "USER_CANCELLED",
          "PROJECT_DELETING",
          "CREDENTIAL_REMOVED",
          "SOURCE_INVALIDATED"
        ]
      },
      "RetrievalComponent": {
        "type": "string",
        "enum": [
          "VECTOR_SEARCH",
          "KEYWORD_SEARCH",
          "SOT_LOOKUP",
          "ANCESTOR_HISTORY"
        ]
      },
      "DegradedStatus": {
        "type": "string",
        "enum": ["PARTIAL", "UNAVAILABLE"]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "INVALID_SSE_CURSOR",
          "UNAUTHENTICATED",
          "ACCOUNT_DISABLED",
          "FORBIDDEN",
          "RESOURCE_NOT_FOUND",
          "PROJECT_DELETING",
          "CHAT_SCOPE_LOCKED",
          "IDEMPOTENCY_KEY_REUSED",
          "CHAT_REQUEST_IN_PROGRESS",
          "CONFLICT_STALE_REVISION",
          "SOURCE_DELETED",
          "SSE_CURSOR_EXPIRED",
          "USER_CREDENTIAL_UNAVAILABLE",
          "DISCLOSURE_REQUIRED",
          "INVALID_EXPLICIT_REFERENCE",
          "EXPLICIT_REFERENCE_BUDGET_EXCEEDED",
          "STAGE_CONTEXT_LIMIT",
          "BRANCH_CONTEXT_LIMIT",
          "APP_USAGE_LIMIT_EXCEEDED",
          "PROVIDER_RATE_LIMITED",
          "PROVIDER_QUOTA_EXHAUSTED",
          "PLATFORM_CREDENTIAL_UNAVAILABLE",
          "PROVIDER_UNAVAILABLE",
          "WORKER_LEASE_EXPIRED"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["code", "message", "retryable", "correlationId"],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "TextBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "TEXT"
          },
          "text": {
            "type": "string"
          }
        },
        "required": ["type", "text"],
        "additionalProperties": false
      },
      "QuoteRefBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "QUOTE_REF"
          },
          "quoteRefId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["type", "quoteRefId"],
        "additionalProperties": false
      },
      "ContentBlock": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextBlock"
          },
          {
            "$ref": "#/components/schemas/QuoteRefBlock"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "TEXT": "#/components/schemas/TextBlock",
            "QUOTE_REF": "#/components/schemas/QuoteRefBlock"
          }
        }
      },
      "Locator": {
        "type": "object",
        "properties": {
          "charStart": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "charEnd": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "prefixAnchor": {
            "type": "string",
            "maxLength": 32
          },
          "suffixAnchor": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": ["charStart", "charEnd", "prefixAnchor", "suffixAnchor"],
        "additionalProperties": false
      },
      "QuoteInput": {
        "type": "object",
        "properties": {
          "quoteRefId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sourceKind": {
            "$ref": "#/components/schemas/QuoteSourceKind"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceRevision": {
            "type": "string"
          },
          "locator": {
            "$ref": "#/components/schemas/Locator"
          },
          "contentHashSha256Hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshotText": {
            "type": "string"
          }
        },
        "required": [
          "quoteRefId",
          "sourceKind",
          "sourceId",
          "sourceRevision",
          "locator",
          "contentHashSha256Hex",
          "snapshotText"
        ],
        "additionalProperties": false
      },
      "StageReference": {
        "type": "object",
        "properties": {
          "granularity": {
            "type": "string",
            "const": "STAGE"
          },
          "targetStageId": {
            "type": "string",
            "format": "uuid"
          },
          "targetChapterId": {
            "type": "null"
          },
          "targetTurnId": {
            "type": "null"
          }
        },
        "required": ["granularity", "targetStageId"],
        "additionalProperties": false
      },
      "ChapterReference": {
        "type": "object",
        "properties": {
          "granularity": {
            "type": "string",
            "const": "CHAPTER"
          },
          "targetStageId": {
            "type": "string",
            "format": "uuid"
          },
          "targetChapterId": {
            "type": "string",
            "format": "uuid"
          },
          "targetTurnId": {
            "type": "null"
          }
        },
        "required": ["granularity", "targetStageId", "targetChapterId"],
        "additionalProperties": false
      },
      "TurnReference": {
        "type": "object",
        "properties": {
          "granularity": {
            "type": "string",
            "const": "TURN"
          },
          "targetStageId": {
            "type": "string",
            "format": "uuid"
          },
          "targetChapterId": {
            "type": "null"
          },
          "targetTurnId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["granularity", "targetStageId", "targetTurnId"],
        "additionalProperties": false
      },
      "MainReference": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StageReference"
          },
          {
            "$ref": "#/components/schemas/ChapterReference"
          },
          {
            "$ref": "#/components/schemas/TurnReference"
          }
        ],
        "discriminator": {
          "propertyName": "granularity",
          "mapping": {
            "STAGE": "#/components/schemas/StageReference",
            "CHAPTER": "#/components/schemas/ChapterReference",
            "TURN": "#/components/schemas/TurnReference"
          }
        }
      },
      "ChatInput": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "mainStageId": {
            "type": "string",
            "format": "uuid"
          },
          "subBranchId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "userContentBlocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            },
            "minItems": 1
          },
          "quotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteInput"
            },
            "default": []
          },
          "mainReferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MainReference"
            },
            "default": []
          }
        },
        "required": [
          "projectId",
          "conversationId",
          "mainStageId",
          "userContentBlocks"
        ],
        "additionalProperties": false
      },
      "ChatAccepted": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/RequestState"
          },
          "effectivePrivacyTierPlanned": {
            "$ref": "#/components/schemas/PrivacyTier"
          },
          "eventsUrl": {
            "type": "string"
          },
          "statusUrl": {
            "type": "string"
          },
          "cancelUrl": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "requestId",
          "correlationId",
          "status",
          "eventsUrl",
          "statusUrl",
          "cancelUrl",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "RequestStatus": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/RequestState"
          },
          "turnId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastEventId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "errorCode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
