{
  "openapi": "3.1.0",
  "info": {
    "title": "ContextFlow public contracts — BranOS-04-1 / 04-2",
    "version": "0.1.0",
    "description": "Contract foundation for four Chat/SSE endpoints and shared API errors/pagination. Auth/workspace/admin DTO details remain in BranOS-04-3/04-4/04-5."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Default Docker Core"
    },
    {
      "url": "http://localhost:18080",
      "description": "Explicit IDE development mode"
    }
  ],
  "paths": {
    "/api/v1/ai/chat-requests": {
      "post": {
        "operationId": "createChatRequest",
        "summary": "Accept a chat request without provider dispatch in the HTTP transaction",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Committed acceptance or idempotent replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-implementation-status": "contract-only; Core business implementation belongs to M1"
      }
    },
    "/api/v1/ai/requests/{requestId}/events": {
      "get": {
        "operationId": "readChatEvents",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read committed backlog then live events; header cursor wins; GET never dispatches provider work",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-events": {
                  "request.accepted": {
                    "$ref": "#/components/schemas/EventAccepted"
                  },
                  "retrieval.degraded": {
                    "$ref": "#/components/schemas/EventDegraded"
                  },
                  "assistant.started": {
                    "$ref": "#/components/schemas/EventStarted"
                  },
                  "assistant.delta": {
                    "$ref": "#/components/schemas/EventDelta"
                  },
                  "assistant.completed": {
                    "$ref": "#/components/schemas/EventCompleted"
                  },
                  "request.failed": {
                    "$ref": "#/components/schemas/EventFailed"
                  },
                  "request.cancelled": {
                    "$ref": "#/components/schemas/EventCancelled"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Normalized API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-implementation-status": "contract-only; Core business implementation belongs to M1"
      }
    },
