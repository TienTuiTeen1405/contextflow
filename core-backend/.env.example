# Spring Boot does not load .env automatically. Export these variables into your shell.
CF_DB_URL=jdbc:postgresql://localhost:15432/contextflow
CF_DB_USERNAME=contextflow
CF_DB_PASSWORD=replace-with-your-local-password
CF_AI_BASE_URL=http://127.0.0.1:8000
CF_WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reserved for M1 Credential Service; not consumed by this scaffold.
CF_INTERNAL_SERVICE_TOKEN=replace-with-a-random-local-token
CF_CREDENTIAL_KEK_V1=replace-with-a-base64-encoded-32-byte-key
