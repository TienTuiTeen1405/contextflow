# Core loads this file's local .env copy via spring.config.import.
# Run from core-backend in IntelliJ or with ./mvnw spring-boot:run.
# Format: Java properties, not shell syntax. Do not quote values or use export.
# setup:local writes escaped properties automatically; never commit the local .env.
CF_DB_URL=jdbc:postgresql://localhost:15432/contextflow
CF_DB_USERNAME=contextflow
CF_DB_PASSWORD=replace-with-your-local-password
# Optional dedicated migration account (CF-DEC-042). Local development falls back to CF_DB_*.
# CF_FLYWAY_URL=jdbc:postgresql://localhost:15432/contextflow
# CF_FLYWAY_USERNAME=contextflow_migrator
# CF_FLYWAY_PASSWORD=replace-with-your-migration-password
# Primary local workflow: Core in IntelliJ/Maven at 18080; Docker Core uses 8080.
CF_CORE_PORT=18080
CF_SERVER_ADDRESS=127.0.0.1
CF_AI_BASE_URL=http://127.0.0.1:18000
CF_WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared with AI in local setup; keep out of Web/NEXT_PUBLIC_*.
CF_INTERNAL_SERVICE_TOKEN=replace-with-a-random-local-token
CF_CREDENTIAL_KEK_V1=replace-with-a-base64-encoded-32-byte-key
