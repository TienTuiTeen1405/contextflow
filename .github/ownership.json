{
  "schemaVersion": 1,
  "status": "roles-defined-members-unassigned",
  "note": "Entity/Repository names reserve ownership; classes are implemented by the owning group, not pre-created here.",
  "roles": {
    "integration-maintainer": {
      "description": "Người duyệt tích hợp, cấu hình chung và CI",
      "github": []
    },
    "core-identity": {
      "description": "Nhóm Core Identity/Credential",
      "github": []
    },
    "core-platform": {
      "description": "Nhóm Core Admin, shared API và idempotency",
      "github": []
    },
    "core-workspace": {
      "description": "Nhóm Core Workspace/Conversation/Lifecycle/Export",
      "github": []
    },
    "core-ai": {
      "description": "Nhóm Core Chat Worker/Continuity/Usage/AI Jobs",
      "github": []
    },
    "core-knowledge": {
      "description": "Nhóm Core KB/Retrieval/SoT",
      "github": []
    },
    "web-lead": {
      "description": "Người duyệt Web",
      "github": []
    },
    "ai-lead": {
      "description": "Người duyệt AI Service/Provider Adapter",
      "github": []
    },
    "data-maintainer": {
      "description": "Người duyệt SQL, migration và bất biến dữ liệu",
      "github": []
    }
  },
  "pathRules": [
    {
      "pattern": "*",
      "requiredReviewRoles": ["integration-maintainer"]
    },
    {
      "pattern": "/web/",
      "requiredReviewRoles": ["web-lead"]
    },
    {
      "pattern": "/ai-service/",
      "requiredReviewRoles": ["ai-lead"]
    },
    {
      "pattern": "/core-backend/",
      "requiredReviewRoles": ["core-platform"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/identity/",
      "requiredReviewRoles": ["core-identity"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/credential/",
      "requiredReviewRoles": ["core-identity"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/admin/",
      "requiredReviewRoles": ["core-platform"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/project/",
      "requiredReviewRoles": ["core-workspace"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/conversation/",
      "requiredReviewRoles": ["core-workspace"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/ai/",
      "requiredReviewRoles": ["core-ai"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/knowledge/",
      "requiredReviewRoles": ["core-knowledge"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/sot/",
      "requiredReviewRoles": ["core-knowledge"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/context/",
      "requiredReviewRoles": ["core-workspace"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/export/",
      "requiredReviewRoles": ["core-workspace"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/common/idempotency/",
      "requiredReviewRoles": ["core-platform"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/common/",
      "requiredReviewRoles": ["integration-maintainer", "core-platform"]
    },
    {
      "pattern": "/core-backend/src/main/java/com/contextflow/contracts/",
      "requiredReviewRoles": ["integration-maintainer", "core-platform"]
    },
    {
      "pattern": "/contracts/",
      "requiredReviewRoles": [
        "integration-maintainer",
        "core-platform",
        "web-lead",
        "ai-lead"
      ]
    },
    {
      "pattern": "/contracts/public.openapi.json",
      "requiredReviewRoles": ["core-platform", "web-lead"]
    },
    {
      "pattern": "/contracts/internal.openapi.json",
      "requiredReviewRoles": ["core-ai", "ai-lead"]
    },
    {
      "pattern": "/core-backend/src/main/resources/db/migration/",
      "requiredReviewRoles": ["data-maintainer", "core-platform"]
    },
    {
      "pattern": "/infra/",
      "requiredReviewRoles": ["integration-maintainer", "data-maintainer"]
    },
    {
      "pattern": "/.github/",
      "requiredReviewRoles": ["integration-maintainer"]
    },
    {
      "pattern": "/scripts/",
      "requiredReviewRoles": ["integration-maintainer"]
    }
  ],
